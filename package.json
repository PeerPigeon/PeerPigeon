{
  "name": "peerpigeon",
  "version": "1.0.0",
  "description": "PeerPigeon: WebRTC partial-mesh networking with gossip broadcast and direct messaging",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "wasm:build": "node scripts/build-wasm.mjs",
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "build:browser": "tsup --config tsup.browser.config.ts",
    "dev:tls:generate": "node scripts/dev-with-mdns.mjs --generate-tls",
    "dev:mdns": "node scripts/dev-with-mdns.mjs",
    "dev:raw": "npm run wasm:build && node scripts/dev-vite.mjs",
    "dev": "npm run dev:mdns",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build",
    "example:basic": "npm --prefix examples/basic run dev",
    "example:vue3": "npm run dev",
    "test": "node scripts/run-e2e-loop.mjs"
  },
  "keywords": [
    "webrtc",
    "p2p",
    "peer-to-peer",
    "mesh",
    "networking",
    "partial-mesh",
    "signaling",
    "auto-discovery",
    "freertc"
  ],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/draeder/peerpigeon.git"
  },
  "dependencies": {
    "freertc": "github:draeder/freertc",
    "unsea": "^1.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^25.0.3",
    "multicast-dns": "^7.2.5",
    "pigeonns": "^1.0.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  }
}
