// The PeerPigeon demo on Cloudflare: a static site, served at pigeon.peer.ooo.
// Deploy with `npm run deploy` (builds, then uploads dist/).
{
  "name": "peerpigeon-demo",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "pigeon.peer.ooo/*", "zone_name": "peer.ooo" }
  ]
}
